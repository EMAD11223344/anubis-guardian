{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "anubis-guardian",
          "version": "1.0.1",
          "informationUri": "https://github.com/EMAD11223344/anubis-guardian",
          "rules": [
            {
              "id": "URL-040",
              "shortDescription": {
                "text": "Secret shipped in a public JavaScript bundle (supabase)"
              },
              "help": {
                "text": "Remove the secret from any code reachable by the client build, move it to server-side env only, rotate the credential at the provider (rotate-first), then purge old bundles/CDN cache."
              },
              "helpUri": "https://github.com/EMAD11223344/anubis-guardian#rules"
            },
            {
              "id": "URL-001",
              "shortDescription": {
                "text": "Site served over plain HTTP (no TLS)"
              },
              "help": {
                "text": "Serve over HTTPS (terminate TLS at the edge/provider, redirect http→https, enable HSTS once stable)."
              },
              "helpUri": "https://github.com/EMAD11223344/anubis-guardian#rules"
            },
            {
              "id": "URL-021",
              "shortDescription": {
                "text": "Session cookie \"sid\" set without HttpOnly (readable by any XSS)"
              },
              "help": {
                "text": "Set HttpOnly on \"sid\" — session cookies must never be readable from JS."
              },
              "helpUri": "https://github.com/EMAD11223344/anubis-guardian#rules"
            },
            {
              "id": "URL-020",
              "shortDescription": {
                "text": "Cookie \"sid\" set without the Secure flag"
              },
              "help": {
                "text": "Set the Secure attribute on \"sid\" (and serve the site over https only)."
              },
              "helpUri": "https://github.com/EMAD11223344/anubis-guardian#rules"
            },
            {
              "id": "URL-010",
              "shortDescription": {
                "text": "Content-Security-Policy header missing"
              },
              "help": {
                "text": "Serve a Content-Security-Policy header (start with a report-then-enforce rollout; script-src 'self', no unsafe-inline for new code). Code map: middleware.ts (response headers) or next.config.js headers()/async headers — or the reverse proxy (nginx/vercel.json)."
              },
              "helpUri": "https://github.com/EMAD11223344/anubis-guardian#rules"
            },
            {
              "id": "URL-012",
              "shortDescription": {
                "text": "Clickjacking protection missing (no X-Frame-Options / frame-ancestors)"
              },
              "help": {
                "text": "Serve X-Frame-Options: DENY (or CSP frame-ancestors 'none') so the site cannot be framed by attacker pages. Code map: middleware.ts (response headers) or next.config.js headers()/async headers — or the reverse proxy (nginx/vercel.json)."
              },
              "helpUri": "https://github.com/EMAD11223344/anubis-guardian#rules"
            },
            {
              "id": "URL-022",
              "shortDescription": {
                "text": "Cookie \"sid\" set without SameSite"
              },
              "help": {
                "text": "Set SameSite=Lax (or Strict) on \"sid\" to blunt CSRF."
              },
              "helpUri": "https://github.com/EMAD11223344/anubis-guardian#rules"
            },
            {
              "id": "URL-013",
              "shortDescription": {
                "text": "X-Content-Type-Options header missing"
              },
              "help": {
                "text": "Serve X-Content-Type-Options: nosniff on all responses. Code map: middleware.ts (response headers) or next.config.js headers()/async headers — or the reverse proxy (nginx/vercel.json)."
              },
              "helpUri": "https://github.com/EMAD11223344/anubis-guardian#rules"
            },
            {
              "id": "URL-014",
              "shortDescription": {
                "text": "Referrer-Policy header missing"
              },
              "help": {
                "text": "Serve Referrer-Policy: strict-origin-when-cross-origin (or stricter). Code map: middleware.ts (response headers) or next.config.js headers()/async headers — or the reverse proxy (nginx/vercel.json)."
              },
              "helpUri": "https://github.com/EMAD11223344/anubis-guardian#rules"
            },
            {
              "id": "URL-015",
              "shortDescription": {
                "text": "Permissions-Policy header missing"
              },
              "help": {
                "text": "Serve a Permissions-Policy restricting camera/microphone/geolocation to none (or first-party only). Code map: middleware.ts (response headers) or next.config.js headers()/async headers — or the reverse proxy (nginx/vercel.json)."
              },
              "helpUri": "https://github.com/EMAD11223344/anubis-guardian#rules"
            },
            {
              "id": "URL-030",
              "shortDescription": {
                "text": "Server header discloses a specific version"
              },
              "help": {
                "text": "Strip or genericize the Server header version at the edge (banner disclosure feeds attacker recon)."
              },
              "helpUri": "https://github.com/EMAD11223344/anubis-guardian#rules"
            },
            {
              "id": "URL-031",
              "shortDescription": {
                "text": "X-Powered-By header discloses the stack"
              },
              "help": {
                "text": "Remove X-Powered-By at the server/proxy (e.g. helmet.hidePoweredBy / proxy hideHeaders)."
              },
              "helpUri": "https://github.com/EMAD11223344/anubis-guardian#rules"
            },
            {
              "id": "URL-905",
              "shortDescription": {
                "text": "security.txt absent (RFC 9116)"
              },
              "help": {
                "text": "Publish /.well-known/security.txt so researchers can report issues safely."
              },
              "helpUri": "https://github.com/EMAD11223344/anubis-guardian#rules"
            },
            {
              "id": "URL-041",
              "shortDescription": {
                "text": "Public bundle references internal/localhost endpoints"
              },
              "help": {
                "text": "Remove internal hostnames from client code; route internal calls through a server-side proxy."
              },
              "helpUri": "https://github.com/EMAD11223344/anubis-guardian#rules"
            },
            {
              "id": "URL-900",
              "shortDescription": {
                "text": "Technology fingerprint: express, nextjs"
              },
              "help": {
                "text": "Informational — findings below pair with code-map hints per detected framework."
              },
              "helpUri": "https://github.com/EMAD11223344/anubis-guardian#rules"
            },
            {
              "id": "URL-043",
              "shortDescription": {
                "text": "Bundle references a sourceMappingURL (check exposure at Level 2)"
              },
              "help": {
                "text": "A .map file is referenced next to http://127.0.0.1:61787/_next/static/app.js. Level 2 checks whether it is actually exposed and ships original sources."
              },
              "helpUri": "https://github.com/EMAD11223344/anubis-guardian#rules"
            }
          ]
        }
      },
